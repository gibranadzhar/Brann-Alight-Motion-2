    <script>    
        lucide.createIcons();    
    
        const BASE_URL = window.location.origin;

        // API Key Modal Functions
        function openApiKeyModal() {
            document.getElementById('apiKeyModal').classList.add('show');
            const saved = localStorage.getItem('merchantApiKey');
            if (saved) {
                document.getElementById('apiKeyInput').value = saved;
                updateActiveKeyUI(saved);
            }
        }

        function closeApiKeyModal() {
            document.getElementById('apiKeyModal').classList.remove('show');
        }

        function updateActiveKeyUI(key) {
            const banner = document.getElementById('activeKeyBanner');
            const text = document.getElementById('activeKeyText');
            if (key) {
                banner.classList.remove('hidden');
                text.textContent = key;
                ['guideKeyParam1', 'guideKeyParam2', 'guideKeyParam3', 'guideKeyParam4'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = key;
                });
                const paramInput = document.getElementById('param-api-history-auto-apikey');
                if (paramInput) paramInput.value = key;
                fetchUserKeyInfo(key);
            } else {
                banner.classList.add('hidden');
                text.textContent = '';
                ['guideKeyParam1', 'guideKeyParam2', 'guideKeyParam3', 'guideKeyParam4'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = 'BRANN-XXXXX';
                });
            }
        }

        async function fetchUserKeyInfo(key) {
            const statusEl = document.getElementById('userKeyTokenStatusText');
            try {
                const res = await fetch('/api/auth/user-key-info', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ apikey: key })
                });
                const data = await res.json();
                if (data.success) {
                    if (data.hasTokens) {
                        statusEl.innerHTML = `<span class="text-emerald-700 font-bold">✅ Token GoPay Aktif</span> (Refresh: ${data.lastRefresh ? new Date(data.lastRefresh).toLocaleString('id-ID') : '-'})`;
                    } else {
                        statusEl.innerHTML = `<span class="text-amber-700 font-bold">⚠️ Token GoPay Belum Di-Setup</span> — Isi form di bawah ini agar API Key aktif!`;
                    }
                } else {
                    statusEl.innerHTML = `<span class="text-red-600 font-bold">❌ Error: ${data.error}</span>`;
                }
            } catch (e) {
                statusEl.innerHTML = `<span class="text-red-600 font-bold">❌ Gagal memuat status: ${e.message}</span>`;
            }
        }

        async function handleUserTokenSave(e) {
            e.preventDefault();
            const apikey = localStorage.getItem('merchantApiKey');
            const accessToken = getVal('userAccessTokenInput');
            const refreshToken = getVal('userRefreshTokenInput');

            if (!apikey) {
                showToast('❌ Login dengan API Key terlebih dahulu!', '❌');
                return;
            }

            try {
                const res = await fetch('/api/auth/user-tokens', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ apikey, accessToken, refreshToken })
                });
                const data = await res.json();
                if (data.success) {
                    showToast('✅ Token GoPay berhasil disimpan!', '✅');
                    document.getElementById('userAccessTokenInput').value = '';
                    document.getElementById('userRefreshTokenInput').value = '';
                    fetchUserKeyInfo(apikey);
                } else {
                    showToast('❌ ' + data.error, '❌');
                }
            } catch (err) {
                showToast('❌ Error: ' + err.message, '❌');
            }
        }

        async function handleApiKeyLogin(e) {
            e.preventDefault();
            const apikey = getVal('apiKeyInput');
            if (!apikey) return;

            try {
                const response = await fetch('/api/auth/login-apikey', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ apikey })
                });
                const data = await response.json();
                if (data.success) {
                    localStorage.setItem('merchantApiKey', apikey);
                    updateActiveKeyUI(apikey);
                    showToast('✅ API Key valid & tersimpan!', '✅');
                } else {
                    showToast('❌ ' + data.error, '❌');
                }
            } catch (err) {
                showToast('❌ Gagal verifikasi key: ' + err.message, '❌');
            }
        }

        function logoutApiKey() {
            localStorage.removeItem('merchantApiKey');
            document.getElementById('apiKeyInput').value = '';
            updateActiveKeyUI(null);
            showToast('Logged out dari API Key', 'ℹ️');
        }

        // Owner Modal & API Key Management Functions
        function openPasswordModal() {
            document.getElementById('passwordModal').classList.add('show');
            document.getElementById('passwordInput').focus();
        }

        function closePasswordModal() {
            document.getElementById('passwordModal').classList.remove('show');
            document.getElementById('passwordForm').reset();
        }

        async function verifyPassword(e) {
            e.preventDefault();
            const password = document.getElementById('passwordInput').value;

            try {
                const response = await fetch('/api/auth/verify-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password })
                });
                const data = await response.json();

                if (data.success) {
                    showToast('✅ Password verified! Membuka Owner Panel...', '✅');
                    document.getElementById('passwordForm').classList.add('hidden');
                    document.getElementById('ownerPanelContainer').classList.remove('hidden');
                    document.getElementById('ownerModalTitle').textContent = '🛡️ Owner Management Portal';
                    fetchOwnerApiKeys();
                } else {
                    showToast('❌ ' + data.error, '❌');
                }
            } catch (e) {
                showToast('❌ Error: ' + e.message, '❌');
            }
        }

        async function fetchOwnerApiKeys() {
            const listEl = document.getElementById('ownerKeyList');
            try {
                const res = await fetch('/api/auth/apikeys');
                const data = await res.json();
                if (data.success) {
                    renderOwnerApiKeys(data.keys);
                } else {
                    listEl.innerHTML = `<div class="text-xs text-red-500 font-bold">Gagal memuat API Keys: ${data.error}</div>`;
                }
            } catch (e) {
                listEl.innerHTML = `<div class="text-xs text-red-500 font-bold">Error: ${e.message}</div>`;
            }
        }

        function renderOwnerApiKeys(keys) {
            const listEl = document.getElementById('ownerKeyList');
            if (!keys || keys.length === 0) {
                listEl.innerHTML = `<div class="text-xs text-gray-500 italic p-3 border-2 border-dashed border-gray-300 rounded-sm">Belum ada API Key aktif. Silahkan buat di atas!</div>`;
                return;
            }

            listEl.innerHTML = keys.map(k => `
                <div class="p-3 bg-white border-2 border-black rounded-sm flex items-center justify-between gap-3 flex-wrap text-xs">
                    <div>
                        <div class="font-bold text-sm text-black flex items-center gap-2 flex-wrap">
                            <span>${k.label || 'API Key'}</span>
                            <span class="text-[10px] bg-slate-200 px-2 py-0.5 rounded font-mono">${k.createdAt ? new Date(k.createdAt).toLocaleDateString('id-ID') : ''}</span>
                            ${k.tokens ? '<span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded">GoPay: Ready</span>' : '<span class="text-[10px] bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded">GoPay: Belum Setup</span>'}
                        </div>
                        <code class="font-mono text-blue-700 font-bold select-all">${k.key}</code>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="copyToClipboard('${k.key}')" class="px-2 py-1 bg-slate-100 border border-black rounded font-bold hover:bg-slate-200">
                            📋 Copy
                        </button>
                        <button onclick="handleOwnerDeleteApiKey('${k.key}')" class="px-2 py-1 bg-red-500 text-white border border-black rounded font-bold hover:bg-red-600">
                            🗑️ Del
                        </button>
                    </div>
                </div>
            `).join('');
        }

        async function handleOwnerAddApiKey(e) {
            e.preventDefault();
            const label = getVal('newKeyLabel');
            const customKey = getVal('newCustomKey');

            try {
                const response = await fetch('/api/auth/apikeys/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ label, customKey })
                });
                const data = await response.json();
                if (data.success) {
                    showToast('✅ API Key berhasil dibuat!', '✅');
                    document.getElementById('newKeyLabel').value = '';
                    document.getElementById('newCustomKey').value = '';
                    fetchOwnerApiKeys();
                } else {
                    showToast('❌ ' + data.error, '❌');
                }
            } catch (err) {
                showToast('❌ Error: ' + err.message, '❌');
            }
        }

        async function handleOwnerDeleteApiKey(key) {
            if (!confirm(`Yakin ingin menghapus API Key:\n${key}?`)) return;

            try {
                const response = await fetch('/api/auth/apikeys/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ key })
                });
                const data = await response.json();
                if (data.success) {
                    showToast('✅ API Key berhasil dihapus!', '🗑️');
                    fetchOwnerApiKeys();
                } else {
                    showToast('❌ ' + data.error, '❌');
                }
            } catch (err) {
                showToast('❌ Error: ' + err.message, '❌');
            }
        }

        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                showToast('API Key disalin!', '📋');
            });
        }

        // Close modal when clicking outside
        ['passwordModal', 'apiKeyModal'].forEach(id => {
            document.getElementById(id)?.addEventListener('click', (e) => {
                if (e.target.id === id) {
                    if (id === 'passwordModal') closePasswordModal();
                    if (id === 'apiKeyModal') closeApiKeyModal();
                }
            });
        });    
    
        function getVal(id) {    
            const el = document.getElementById(id);    
            return el ? el.value.trim() : '';    
        }    
    
        let toastTimer;    
        function showToast(message, icon = '✅') {    
            const toast = document.getElementById('toast');    
            const msg = document.getElementById('toast-msg');    
            const iconEl = toast.querySelector('.toast-icon');    
            iconEl.textContent = icon;    
            msg.textContent = message;    
            toast.classList.add('show');    
            clearTimeout(toastTimer);    
            toastTimer = setTimeout(() => {    
                toast.classList.remove('show');    
            }, 2400);    
        }    
    
        function copyEndpointWithParams(endpointKey, path, paramNames) {    
            const params = {};    
            let filledCount = 0;    
            paramNames.forEach(pName => {    
                const inputId = `param-${endpointKey}-${pName}`;    
                const val = getVal(inputId);    
                params[pName] = val;     
                if (val !== '') filledCount++;    
            });    
            const query = new URLSearchParams(params).toString();    
            const fullUrl = query ? `${BASE_URL}${path}?${query}` : `${BASE_URL}${path}`;    
            navigator.clipboard.writeText(fullUrl).then(() => {    
                const btn = document.getElementById(`copy-btn-${endpointKey}`);    
                if (btn) {    
                    btn.classList.add('copied');    
                    setTimeout(() => btn.classList.remove('copied'), 1500);    
                }    
                const suffix = filledCount > 0 ? ` (+ ${filledCount} param)` : '';    
                showToast(`URL disalin${suffix}`, '📋');    
            }).catch(() => {    
                const ta = document.createElement('textarea');    
                ta.value = fullUrl;    
                ta.style.position = 'fixed'; ta.style.opacity = '0';    
                document.body.appendChild(ta);    
                ta.select();    
                try { document.execCommand('copy'); showToast('URL disalin', '📋'); } catch (e) { showToast('Gagal menyalin', '⚠️'); }    
                document.body.removeChild(ta);    
            });    
        }    
    
        function copyResult(preId) {    
            const pre = document.getElementById(preId);    
            if (!pre) return;    
            const text = pre.innerText || pre.textContent;    
            navigator.clipboard.writeText(text).then(() => {    
                const terminal = pre.closest('.api-terminal');    
                const btn = terminal ? terminal.querySelector('.copy-result-btn') : null;    
                if (btn) {    
                    btn.classList.add('copied');    
                    setTimeout(() => btn.classList.remove('copied'), 1500);    
                }    
                showToast('Result disalin', '📋');    
            }).catch(() => {    
                const ta = document.createElement('textarea');    
                ta.value = text;    
                ta.style.position = 'fixed'; ta.style.opacity = '0';    
                document.body.appendChild(ta);    
                ta.select();    
                try { document.execCommand('copy'); showToast('Result disalin', '📋'); } catch (e) { showToast('Gagal menyalin', '⚠️'); }    
                document.body.removeChild(ta);    
            });    
        }    
    
        async function fetchGET(url, params = {}) {    
            Object.keys(params).forEach(k => {    
                if (params[k] === '' || params[k] === null || params[k] === undefined) delete params[k];    
            });    
            const query = new URLSearchParams(params).toString();    
            const fullUrl = query ? `${url}?${query}` : url;    
            try {    
                const res = await fetch(fullUrl);    
                const data = await res.json();    
                return data;    
            } catch (error) {    
                return {    
                    success: false,    
                    error_type: "Network / CORS Error",    
                    message: error.message,    
                    attempted_url: fullUrl,    
                    hint: "Pastikan backend server berjalan dan mengizinkan CORS."    
                };    
            }    
        }    
    
        async function runApiTest(endpoint, params, resultElementId) {    
            const resEl = document.getElementById(resultElementId);    
            resEl.innerText = "// Loading...";    
            resEl.style.color = '#fbbf24';    
            try {    
                const res = await fetchGET(endpoint, params);    
                resEl.style.color = res.error_type === "Network / CORS Error" ? '#f87171' : '#b4f0c8';    
                resEl.innerText = JSON.stringify(res, null, 2);    
            } catch (e) {    
                resEl.style.color = '#f87171';    
                resEl.innerText = "// Error:\n" + e.message;    
            }    
        }    
    
        document.addEventListener('DOMContentLoaded', () => {    
            lucide.createIcons();
            const savedKey = localStorage.getItem('merchantApiKey');
            if (savedKey) {
                updateActiveKeyUI(savedKey);
            }
        });    
        const observer = new MutationObserver(() => { lucide.createIcons(); });    
        observer.observe(document.getElementById('toast'), { childList: true, subtree: true });    
    </script>    
</body>    
</html>    
